---
import Layout from '../layouts/layout.astro';
import Splash from '../components/splash.astro';
import Hero from '../components/hero.astro';
import Workspace from '../components/workspace.astro';

const name = 'Om Patel';

const links = [
  { label: 'Work', href: '#work' },
  { label: 'Contact', href: '#contact' },
];
---

<Layout title={name} description={`${name}'s portfolio`}>
  <!-- neofetch rows (OS, WM, hardware...) are read from the visitor's browser at runtime -->
  <Splash user="ompatel" host="portfolio" command="init" />

  <main>
    <Hero {name} tagline="designs and builds for the web." {links} />

    <section id="work" class="work">
      <Workspace />
    </section>
  </main>
</Layout>
