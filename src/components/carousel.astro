---
import { slides, carouselOptions } from '../config/carousel';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const items = slides.map((s) => ({ ...s, src: base + s.src.replace(/^\//, '') }));
const pad = (n: number) => String(n).padStart(2, '0');
---

<div
  class="cr"
  id="carousel"
  role="region"
  aria-roledescription="carousel"
  aria-label="Featured work"
  data-slides={JSON.stringify(items)}
  data-options={JSON.stringify(carouselOptions)}
>
  <div class="cr-stage">
    <canvas class="cr-canvas" role="img" aria-label={items[0]?.alt}></canvas>

    <!-- shown only when WebGL is unavailable -->
    <ul class="cr-fallback">
      {items.map((s, i) => <li class:list={{ 'is-on': i === 0 }}><img src={s.src} alt={s.alt} loading={i ? 'lazy' : 'eager'} /></li>)}
    </ul>

    <div class="cr-ui">
      <div class="cr-top">
        <span class="cr-count" data-ui="count">01 / {pad(items.length)}</span>
        <span class="cr-spacer"></span>
        <button class="cr-btn" type="button" data-ui="play">pause</button>
        <button class="cr-btn" type="button" data-ui="close" aria-label="Exit full screen" hidden>close ×</button>
      </div>
      <button class="cr-arrow prev" type="button" data-ui="prev" aria-label="Previous slide">‹</button>
      <button class="cr-arrow next" type="button" data-ui="next" aria-label="Next slide">›</button>
      <div class="cr-cap">
        <span class="cr-title" data-ui="title"></span>
        <span class="cr-hint" data-ui="hint"></span>
        <span class="cr-hint cr-enter">scroll up to expand</span>
        <span class="cr-hint cr-exit">scroll down or Esc to exit</span>
      </div>
    </div>
    <p class="sr-only" data-ui="status" aria-live="off"></p>
  </div>
</div>

<style is:global>
  .cr {
    position: relative;
    /* the hero: fills the first screen (minus the top bar and the "See my work" row) */
    height: calc(100svh - var(--topbar-h) - 3.75rem);
    min-height: 26rem;
    overscroll-behavior-x: none; /* no browser swipe-back while swiping the carousel */
  }
  .cr-stage {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .cr-stage.is-max {
    position: fixed;
    z-index: 250; /* above the top bar (200) */
    background: var(--bg);
  }
  .cr-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    touch-action: pan-y;
  }
  .cr-stage.is-max .cr-canvas { touch-action: none; }

  .cr-fallback { display: none; position: absolute; inset: 0; margin: 0; padding: 0; list-style: none; }
  .cr-fallback li { position: absolute; inset: 0; opacity: 0; transition: opacity 0.6s; }
  .cr-fallback li.is-on { opacity: 1; }
  .cr-fallback img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cr.no-gl .cr-fallback { display: block; }
  .cr.no-gl .cr-canvas { display: none; }

  .cr-ui { position: absolute; inset: 0; pointer-events: none; font: 400 12px/1 var(--mono); color: var(--fg); }
  .cr-ui > * { pointer-events: none; }
  .cr-ui button { pointer-events: auto; }
  .cr-top { position: absolute; top: 0.75rem; left: 0.9rem; right: 0.9rem; display: flex; align-items: center; gap: 0.5rem; }
  .cr-spacer { flex: 1; }
  .cr-count, .cr-title { text-shadow: 0 1px 8px var(--shadow); }
  .cr-btn {
    padding: 0.4rem 0.65rem;
    border: 1px solid var(--line-strong);
    border-radius: 3px;
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    backdrop-filter: blur(6px);
    color: var(--fg);
    font: inherit;
    cursor: pointer;
  }
  .cr-btn:hover { border-color: var(--accent); }
  .cr-arrow {
    position: absolute;
    top: 50%;
    width: 2.5rem;
    height: 2.5rem;
    margin-top: -1.25rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    color: var(--fg);
    font: 400 1.25rem/1 var(--mono);
    cursor: pointer;
  }
  .cr-arrow:hover { border-color: var(--accent); color: var(--accent); }
  .cr-arrow.prev { left: 0.9rem; }
  .cr-arrow.next { right: 0.9rem; }
  .cr-cap { position: absolute; left: 0.9rem; right: 0.9rem; bottom: 0.85rem; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 1rem; }
  .cr-hint { color: var(--dim); text-shadow: 0 1px 8px var(--shadow); }
  .cr-enter, .cr-exit { margin-left: auto; }
  .cr-exit { display: none; }
  .cr[data-max='1'] .cr-exit { display: inline; }
  .cr[data-max='1'] .cr-enter { display: none; }
  .cr :is(button):focus-visible { outline: 1px solid var(--accent); outline-offset: 2px; }
  .sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  @media (max-width: 700px) {
    .cr-arrow { display: none; }
    .cr-hint:not(.cr-exit) { display: none; }
    .cr-enter { display: none; }
  }
</style>

<script>
  import { Carousel } from "../hero/carousel";

  const root = document.getElementById("carousel");
  if (root) {
    new Carousel(
      root,
      JSON.parse(root.dataset.slides || "[]"),
      JSON.parse(root.dataset.options || '{"autoplayMs":7000,"pauseOnHover":true,"autoEffects":true}'),
    );
  }
</script>
