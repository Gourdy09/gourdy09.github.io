---
interface Props {
  user?: string;
  host?: string;
  /** The command the visitor has to type */
  command?: string;
}

const { user = "ompatel", host = "portfolio", command = "init" } = Astro.props;
const title = `${user}@${host}`;
const rule = "-".repeat(title.length);

// Neofetch-style grayscale blocks.
const blocks = [
  [
    "#0b0b0b",
    "#242424",
    "#3d3d3d",
    "#575757",
    "#717171",
    "#8c8c8c",
    "#a6a6a6",
    "#c0c0c0",
  ],
  [
    "#1a1a1a",
    "#333333",
    "#4d4d4d",
    "#666666",
    "#808080",
    "#9b9b9b",
    "#b5b5b5",
    "#f4f4f4",
  ],
];
---

<div
  class="splash"
  id="splash"
  data-command={command}
  data-user={user}
  data-host={host}
>
  <div class="term" id="term">
    <!-- the header/clock now lives in the global top bar (components/topbar.astro) -->
    <div class="screen" id="screen">
      <section class="fetch">
        <div class="art">
          <img src="/gourdy.svg" alt="Gourdy mascot" />
        </div>

        <div class="info" id="info">
          <div class="line">
            <span class="k">{user}</span>@<span class="k">{host}</span>
          </div>
          <div class="line">{rule}</div>
          <div class="line" data-rows-end></div>
          {
            blocks.map((row) => (
              <div class="line blocks">
                {row.map((color) => (
                  <i style={`background:${color}`} />
                ))}
              </div>
            ))
          }
        </div>
      </section>

      <div class="log" id="log"></div>
    </div>
  </div>

  <!-- RGB ghosting and horizontal tear layers, activated only during exit -->
  <div class="glitch-layer glitch-red" aria-hidden="true"></div>
  <div class="glitch-layer glitch-cyan" aria-hidden="true"></div>
  <div class="tear-layer" aria-hidden="true"></div>

  <input
    class="ghost"
    id="ghost"
    type="text"
    autocomplete="off"
    autocapitalize="off"
    spellcheck="false"
    aria-label="Terminal input"
  />
</div>

<style>
  .splash {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    z-index: 100;
    background: var(--term);
    display: flex;
    overflow: hidden;
    isolation: isolate;
  }

  .term {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    width: 100%;
    height: 100%;
    background: var(--term);
    font: 400 clamp(11px, 0.7vw + 6px, 14px) / 1.35 var(--mono);
    transform-origin: center center;
    will-change: transform, filter, opacity;
  }

  .screen {
    flex: 1;
    min-height: 0;
    min-width: 0;
    /* leave room for the fixed top bar */
    padding: calc(var(--topbar-h) + 1.2em) 1.5em 1.2em;
    overflow-x: hidden;
    overflow-y: hidden;
    color: var(--fg);
  }

  .fetch {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    column-gap: 4ch;
    align-items: start;
    margin-bottom: 1.35em;
    min-width: 0;
  }

  .art {
    opacity: 0;
    line-height: 0;
    margin: 2em 4em 4em;
  }

  .art img {
    display: block;
    width: 16em;
    height: auto;
    image-rendering: pixelated;
  }

  .info :global(.line) {
    opacity: 0;
  }

  .k {
    color: var(--accent);
    font-weight: 700;
  }

  .blocks i {
    display: inline-block;
    width: 3ch;
    height: 1.35em;
    vertical-align: top;
  }

  .splash :global(.line) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    word-break: normal;
    min-width: 0;
    min-height: 1.35em;
  }

  .splash :global(.red) {
    color: var(--accent);
  }
  .splash :global(.dim) {
    color: var(--dim);
  }
  .splash :global(.b) {
    font-weight: 700;
  }
  .splash :global(.gap) {
    margin-top: 0.7em;
  }
  .log :global(.line) {
    opacity: 1;
  }

  .info,
  .log {
    min-width: 0;
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .ghost {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
    font-size: 16px;
  }

  /* Glitch layers sit over the terminal only during the exit transition. */
  .glitch-layer,
  .tear-layer {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
  }

  .glitch-red {
    background: rgba(255, 0, 65, 0.16);
    mix-blend-mode: screen;
  }

  .glitch-cyan {
    background: rgba(0, 235, 255, 0.15);
    mix-blend-mode: screen;
  }

  .tear-layer {
    z-index: 6;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 5px,
      rgba(255, 255, 255, 0.08) 6px,
      transparent 8px,
      transparent 13px
    );
  }

  .splash.is-glitching .glitch-layer,
  .splash.is-glitching .tear-layer {
    visibility: visible;
  }

  @media (max-width: 700px) {
    .fetch {
      grid-template-columns: minmax(0, 1fr);
      justify-content: start;
      row-gap: 1em;
    }

    .art img {
      width: 8em;
      height: auto;
    }

    .art {
      margin: 1em 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .term {
      will-change: auto;
    }
  }

  .splash.is-blackout {
    background: var(--term) !important;
  }

  .splash.is-blackout .term {
    visibility: hidden;
  }
</style>

<script>
  import gsap from "gsap";
  import { lenis } from "../setup/lenis";
  import { getSystemInfo, type SystemInfo } from "../setup/sysinfo";

  const root = document.getElementById("splash") as HTMLElement | null;
  const skipped =
    !root || document.documentElement.classList.contains("no-splash");

  if (skipped) lenis.start();
  else start(root!);

  async function start(root: HTMLElement) {
    lenis.stop();
    const sys = await getSystemInfo();
    play(root, sys);
  }

  function play(root: HTMLElement, sys: SystemInfo) {
    const $ = <T extends Element>(sel: string) => root.querySelector(sel) as T;
    const rand = gsap.utils.random;

    const COMMAND = root.dataset.command ?? "init";
    const USER = root.dataset.user ?? "ompatel";
    const HOST = root.dataset.host ?? "portfolio";
    const path = (...parts: string[]) =>
      [sys.home, "portfolio", ...parts].join(sys.sep);

    const STEPS = [
      { tool: "Read", arg: path("profile.json"), result: "Read 42 lines" },
      {
        tool: "Glob",
        arg: path("projects", "**", "*.mdx"),
        result: "Found 6 files",
      },
      { tool: "Bash", arg: "npm run build", result: "Built in 1.4s" },
      {
        tool: "Write",
        arg: path("src", "pages", "index.astro"),
        result: "Wrote 64 lines",
      },
    ];

    const term = $<HTMLElement>("#term");
    const screen = $<HTMLElement>("#screen");
    const log = $<HTMLElement>("#log");
    const ghost = $<HTMLInputElement>("#ghost");
    const info = $<HTMLElement>("#info");
    const redLayer = $<HTMLElement>(".glitch-red");
    const cyanLayer = $<HTMLElement>(".glitch-cyan");
    const tearLayer = $<HTMLElement>(".tear-layer");

    const rows: [string, string | null, string?][] = [
      ["OS", sys.os],
      ["Host", sys.host],
      ["Engine", sys.engine],
      ["Uptime", "", "uptime"],
      ["Shell", sys.shell],
      ["Resolution", sys.resolution],
      ["WM", sys.wm],
      ["Terminal", sys.terminal],
      ["CPU", sys.cpu],
      ["GPU", sys.gpu],
      ["Memory", sys.memory],
      ["Battery", sys.battery],
      ["Locale", sys.locale],
    ];

    const anchor = info.querySelector("[data-rows-end]")!;
    let uptimeEl: HTMLElement | null = null;

    for (const [key, value, liveName] of rows) {
      if (value === null) continue;
      const line = document.createElement("div");
      line.className = "line";
      const k = document.createElement("span");
      k.className = "k";
      k.textContent = key;
      const v = document.createElement("span");
      v.textContent = value;
      line.append(k, ": ", v);
      if (liveName === "uptime") uptimeEl = v;
      info.insertBefore(line, anchor);
    }

    // The clock now lives in the top bar; this only keeps the neofetch "Uptime" row ticking.
    const startedAt = performance.now();
    function tickUptime() {
      if (!uptimeEl) return;
      const s = Math.floor((performance.now() - startedAt) / 1000);
      uptimeEl.textContent = `${Math.floor(s / 60)} mins, ${s % 60} secs`;
    }
    tickUptime();
    const clockTimer = window.setInterval(tickUptime, 1000);

    const isPS = sys.shell === "PowerShell";
    const isZsh = sys.shell === "zsh";

    function addLine(parts: [string, string?][], before?: Element | null) {
      const line = document.createElement("div");
      line.className = "line";
      const spans = parts.map(([text, cls]) => {
        const s = document.createElement("span");
        s.textContent = text;
        if (cls) s.className = cls;
        line.append(s);
        return s;
      });
      log.insertBefore(line, before ?? null);
      screen.scrollTop = screen.scrollHeight;
      return { line, spans };
    }

    let typed!: HTMLElement;
    let cursor!: HTMLElement;

    function newPrompt() {
      const parts: [string, string?][] = isPS
        ? [["PS ", "red b"], [`${sys.home}> `]]
        : isZsh
          ? [[`${USER}@${HOST}`, "red b"], [" ~ % "]]
          : [[`${USER}@${HOST}`, "red b"], [":~$ "]];
      const { line } = addLine(parts);
      typed = document.createElement("span");
      cursor = document.createElement("span");
      cursor.className = "cursor blink";
      line.append(typed, cursor);
    }

    function notFound(cmd: string) {
      if (isPS)
        return `${cmd} : The term '${cmd}' is not recognized as the name of a cmdlet, function, script file, or operable program.`;
      return isZsh
        ? `zsh: command not found: ${cmd}`
        : `bash: ${cmd}: command not found`;
    }

    let locked = true;
    let idleTimer: number | undefined;
    let run: gsap.core.Timeline | undefined;

    const boot = gsap.timeline({
      onComplete: () => {
        const { line } = addLine([
          ["type "],
          [COMMAND, "red b"],
          [" and press enter · "],
          ["esc", "red b"],
          [" to skip", "dim"],
        ]);
        line.classList.add("gap");
        newPrompt();
        locked = false;
        ghost.focus({ preventScroll: true });
        idleTimer = window.setTimeout(autoType, 5500);
      },
    });

    boot.to($(".art"), { opacity: 1, duration: 0.4 }, 0.2);
    boot.to(
      info.querySelectorAll(".line"),
      { opacity: 1, duration: 0.2, stagger: 0.05 },
      0.2,
    );

    root.addEventListener("click", () => {
      if (!locked) ghost.focus({ preventScroll: true });
    });

    ghost.addEventListener("input", () => {
      if (locked) {
        ghost.value = "";
        return;
      }
      window.clearTimeout(idleTimer);
      cursor.classList.remove("blink");
      typed.textContent = ghost.value;
    });

    ghost.addEventListener("keydown", (e) => {
      if (e.key !== "Enter" || locked) return;
      e.preventDefault();
      const cmd = ghost.value.trim();
      ghost.value = "";
      submit(cmd);
    });

    function autoType() {
      locked = true;
      cursor.classList.remove("blink");
      const t = gsap.timeline();
      [...COMMAND].forEach((_, i) => {
        t.call(
          () => {
            typed.textContent = COMMAND.slice(0, i + 1);
          },
          [],
          `+=${rand(0.12, 0.22)}`,
        );
      });
      t.call(() => submit(COMMAND), [], "+=0.4");
    }

    function submit(cmd: string, fast = false) {
      if (run) return;
      cursor.classList.remove("blink");
      cursor.style.display = "none";
      if (cmd === "") return newPrompt();
      if (cmd !== COMMAND) {
        addLine([[notFound(cmd)]]);
        return newPrompt();
      }
      locked = true;
      ghost.blur();
      init(fast);
    }

    const FRAMES = ["·", "✢", "✳", "✶", "✻", "✽"];
    let spin:
      { line: HTMLElement; glyph: HTMLElement; label: HTMLElement } | undefined;
    let spinTimer: number | undefined;

    function startSpinner() {
      const spinStart = Date.now();
      const { line, spans } = addLine([
        ["✻ ", "red"],
        ["Initializing… "],
        ["(0s · esc to interrupt)", "dim"],
      ]);
      line.classList.add("gap");
      spin = { line, glyph: spans[0], label: spans[2] };
      let frame = 0;
      spinTimer = window.setInterval(() => {
        frame = (frame + 1) % FRAMES.length;
        spin!.glyph.textContent = `${FRAMES[frame]} `;
        spin!.label.textContent = `(${Math.floor((Date.now() - spinStart) / 1000)}s · esc to interrupt)`;
      }, 130);
    }

    function stopSpinner() {
      window.clearInterval(spinTimer);
      spin?.line.remove();
      spin = undefined;
    }

    function init(fast: boolean) {
      window.clearTimeout(idleTimer);
      run = gsap.timeline({ onComplete: finish });
      if (fast) run.timeScale(8);

      run.call(
        () => {
          const { line } = addLine([
            ["● ", "red"],
            [
              "Initializing your portfolio. I'll read the profile, load the projects and build the site.",
            ],
          ]);
          line.classList.add("gap");
          startSpinner();
        },
        [],
        0.3,
      );

      STEPS.forEach((step) => {
        run!.call(
          () => {
            addLine(
              [
                ["● ", "red"],
                [step.tool, "b"],
                [`(${step.arg})`, "dim"],
              ],
              spin?.line,
            );
          },
          [],
          `+=${rand(0.45, 0.8)}`,
        );

        run!.call(
          () => {
            addLine(
              [
                ["  ⎿  ", "dim"],
                [step.result, "dim"],
              ],
              spin?.line,
            );
          },
          [],
          `+=${rand(0.35, 0.7)}`,
        );
      });

      run.call(
        () => {
          stopSpinner();
          const { line } = addLine([
            ["● ", "red"],
            ["Done. Launching the site…"],
          ]);
          line.classList.add("gap");
        },
        [],
        "+=0.8",
      );

      // Cyberpunk glitch: RGB split, rapid horizontal tearing, then a clean reveal.

      // Two-stage cyberpunk exit: aggressive glitch → black → second glitch → site.
      run.add("reveal", ">+=0.25");

      run.call(
        () => {
          run!.timeScale(1);
          root.classList.add("is-glitching");
          window.dispatchEvent(new Event("splash:reveal"));
        },
        [],
        "reveal",
      );

      // BURST 1 — aggressive terminal distortion.
      run.to(
        redLayer,
        {
          opacity: 1,
          x: -24,
          clipPath: "inset(0 0 48% 0)",
          duration: 0.035,
          ease: "steps(2)",
        },
        "reveal",
      );

      run.to(
        cyanLayer,
        {
          opacity: 1,
          x: 24,
          clipPath: "inset(52% 0 0 0)",
          duration: 0.035,
          ease: "steps(2)",
        },
        "reveal",
      );

      run.to(
        tearLayer,
        {
          opacity: 1,
          x: 12,
          duration: 0.035,
          ease: "steps(2)",
        },
        "reveal",
      );

      // Rapid, exaggerated screen shake.
      run.to(
        term,
        {
          x: 18,
          skewX: -3,
          filter: "contrast(2.5) saturate(3) hue-rotate(-20deg)",
          duration: 0.045,
          ease: "steps(2)",
        },
        "reveal+=0.025",
      );

      run.to(
        term,
        {
          x: -22,
          skewX: 4,
          scaleX: 1.025,
          duration: 0.045,
          ease: "steps(2)",
        },
        "reveal+=0.07",
      );

      run.to(
        redLayer,
        {
          x: 32,
          clipPath: "inset(18% 0 55% 0)",
          duration: 0.045,
          ease: "steps(2)",
        },
        "reveal+=0.075",
      );

      run.to(
        cyanLayer,
        {
          x: -30,
          clipPath: "inset(62% 0 12% 0)",
          duration: 0.045,
          ease: "steps(2)",
        },
        "reveal+=0.08",
      );

      run.to(
        term,
        {
          x: 12,
          skewX: -2,
          scaleX: 0.98,
          filter: "contrast(3) saturate(4) brightness(1.5)",
          duration: 0.045,
          ease: "steps(2)",
        },
        "reveal+=0.12",
      );

      run.to(
        tearLayer,
        {
          x: -18,
          opacity: 1,
          duration: 0.045,
          ease: "steps(2)",
        },
        "reveal+=0.13",
      );

      // Hard cut to pure black. The website stays hidden behind the overlay.
      run.to(
        term,
        {
          opacity: 0,
          x: 0,
          skewX: 0,
          scaleX: 1,
          filter: "none",
          duration: 0.055,
          ease: "steps(2)",
        },
        "reveal+=0.19",
      );

      run.call(
        () => {
          root.classList.remove("is-glitching");
          root.classList.add("is-blackout");
        },
        [],
        "reveal+=0.245",
      );

      run.set(
        [redLayer, cyanLayer, tearLayer],
        {
          opacity: 0,
          x: 0,
          clipPath: "inset(0% 0% 0% 0%)",
        },
        "reveal+=0.245",
      );

      // Brief black screen before the signal tries to reconnect.
      // BURST 2 — a short, brighter glitch over black.
      run.call(
        () => {
          root.classList.remove("is-blackout");
          root.classList.add("is-glitching", "is-blackout");
        },
        [],
        "reveal+=0.43",
      );

      run.to(
        redLayer,
        {
          opacity: 1,
          x: -32,
          clipPath: "inset(35% 0 45% 0)",
          duration: 0.035,
          ease: "steps(2)",
        },
        "reveal+=0.45",
      );

      run.to(
        cyanLayer,
        {
          opacity: 1,
          x: 32,
          clipPath: "inset(58% 0 20% 0)",
          duration: 0.035,
          ease: "steps(2)",
        },
        "reveal+=0.45",
      );

      run.to(
        tearLayer,
        {
          opacity: 1,
          x: 20,
          duration: 0.035,
          ease: "steps(2)",
        },
        "reveal+=0.45",
      );

      // Inverted offsets create a final digital snap.
      run.to(
        [redLayer, cyanLayer, tearLayer],
        {
          x: -8,
          duration: 0.035,
          ease: "steps(2)",
        },
        "reveal+=0.49",
      );

      run.to(
        [redLayer, cyanLayer, tearLayer],
        {
          x: 0,
          opacity: 0,
          duration: 0.055,
          ease: "steps(2)",
        },
        "reveal+=0.53",
      );

      // Reveal the real site by removing the splash.
      run.call(
        () => {
          root.classList.remove("is-glitching", "is-blackout");
        },
        [],
        "reveal+=0.59",
      );
    }
    // Escape works during the intro, prompt, initialization, and glitch.
    let dismissed = false;

    function finish() {
      if (dismissed) return;
      dismissed = true;

      window.removeEventListener("keydown", onKey);

      window.clearInterval(clockTimer);
      window.clearInterval(spinTimer);
      window.clearTimeout(idleTimer);

      boot.kill();
      run?.kill();

      // Clear any transition states.
      root.classList.remove("is-glitching", "is-blackout");

      // Tell the rest of the site to reveal itself.
      window.dispatchEvent(new Event("splash:reveal"));

      root.remove();
      lenis.start();
    }

    function onKey(e: KeyboardEvent) {
      if (e.key !== "Escape") return;

      e.preventDefault();
      e.stopPropagation();

      finish();
    }

    window.addEventListener("keydown", onKey);
  }
</script>