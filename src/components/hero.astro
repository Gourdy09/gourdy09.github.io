---
import Carousel from "./carousel.astro";
import Network from "./network.astro";

interface Props {
  name: string;
  tagline: string;
}
const { name, tagline } = Astro.props;
---

<section class="hero">
  <h1 class="sr-only">{name}: {tagline}</h1>

  <Carousel />

  <a class="cue" href="#work" data-fade>
    <span>See my work</span>
    <span class="cue-arrow" aria-hidden="true">↓</span>
  </a>
</section>

<section class="about" id="about" data-fade>
  <div class="about-text">
    <span class="path">~/portfolio/about</span>
    <span class="sigil">%</span><span class="cursor blink"></span>

    <h1> <span style="color: var(--accent);">&gt;</span> more than my weights</h1>

    <p style="font: 400 var(--mono)">
      Lorem ipsum dolor sit amet, consectetur adipiscing elit. Duis quis lacus
      eu ligula lobortis varius. Fusce euismod ut arcu quis luctus. Sed laoreet
      ultrices urna ac elementum. Ut consectetur hendrerit ullamcorper. Quisque
      eleifend sit amet tortor in lobortis. Suspendisse velit felis, fringilla
      vel felis in, pulvinar placerat nisl. In lectus nunc, sagittis id lectus
      vitae, mollis eleifend justo. Maecenas dignissim, est sed rhoncus
      malesuada, orci augue dictum nulla, vehicula vehicula magna nisl eget
      nulla. Curabitur non sem tincidunt dui scelerisque pharetra. In hac
      habitasse platea dictumst. Morbi sit amet eros mi.
    </p>
  </div>
  <div class="network">
    <Network />
  </div>
</section>

<style>
  /* the hero is exactly one screen: full-width carousel on top, the cue underneath */
  .hero {
    height: calc(100svh - var(--topbar-h));
    display: grid;
    grid-template-rows: 1fr auto;
  }
  .about {
    /* paragraph on the left, the network fills the rest of the row */
    display: grid;
    grid-template-columns: minmax(0, 80ch) minmax(0, 1fr);
    align-items: stretch;
    gap: clamp(1.5rem, 5vw, 3.5rem);
    padding: clamp(2rem, 6vw, 4rem) clamp(1.25rem, 4vw, 2.5rem);
    font: 400 0.9rem var(--mono);
  }
  .about-text {
    max-width: 80ch;
  }
  @media (max-width: 1100px) {
    .about {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .about p {
    margin: 0.75rem 0 0;
    font-family: var(--sans, inherit);
    line-height: 1.6;
  }
  .path {
    color: var(--dim);
  }
  .sigil {
    color: var(--accent);
  }

  .cue {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem clamp(1.25rem, 4vw, 2.5rem);
    color: var(--fg);
    font: 400 0.9rem var(--mono);
    text-decoration: none;
  }
  .cue:hover,
  .cue:focus-visible {
    color: var(--accent);
  }
  .cue-arrow {
    display: inline-block;
  }
  @media (prefers-reduced-motion: no-preference) {
    .cue-arrow {
      animation: cue-bob 1.6s ease-in-out infinite;
    }
    @keyframes cue-bob {
      50% {
        transform: translateY(5px);
      }
    }
  }

  [data-fade] {
    opacity: 0;
    transform: translateY(12px);
  }
</style>

<script>
  import gsap from "gsap";
  import { lenis } from "../setup/lenis";

  const play = () =>
    gsap
      .timeline({ defaults: { ease: "power3.out" } })
      .to(
        "[data-fade]",
        { opacity: 1, y: 0, duration: 0.8, stagger: 0.1 },
        0.2,
      );

  if (document.documentElement.classList.contains("no-splash")) play();
  else window.addEventListener("splash:reveal", play, { once: true });

  // "See my work": smooth scroll to the workspace (the top bar is fixed, so offset by its height)
  document
    .querySelector<HTMLAnchorElement>(".hero .cue")
    ?.addEventListener("click", (e) => {
      const work = document.getElementById("work");
      if (!work) return;
      e.preventDefault();
      const bar =
        document.querySelector(".topbar")?.getBoundingClientRect().height ?? 0;
      // absolute position: Lenis' element lookup ignores the body's top-bar padding
      lenis.scrollTo(work.getBoundingClientRect().top + window.scrollY - bar, {
        duration: 1.4,
      });
    });
</script>
