---
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/instrument-sans';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Your Name', description = 'Portfolio' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Runs before first paint: skip the splash on repeat visits / reduced motion -->
    <script is:inline>
      try {
        if (sessionStorage.getItem('splash-seen')) {
          document.documentElement.classList.add('no-splash');
        }
      } catch (e) {}
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('no-splash');
      }
    </script>

    <noscript>
      <style is:inline>
        .splash { display: none !important; }
        .hero .inner { transform: none !important; }
        .hero [data-fade] { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>
  </head>

  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    /* coal / cream / red */
    --bg: #141211;
    --term: #1b1816;
    --fg: #efe6d4;
    --dim: #8c8478;
    --accent: #e0402f;
    --line: rgba(239, 230, 212, 0.12);

    --mono: 'JetBrains Mono Variable', ui-monospace, monospace;
    --sans: 'Instrument Sans Variable', system-ui, sans-serif;
  }

  *, *::before, *::after { box-sizing: border-box; }

  html { background: var(--bg); color: var(--fg); }

  body {
    margin: 0;
    font-family: var(--sans);
    -webkit-font-smoothing: antialiased;
  }

  a { color: inherit; text-decoration: none; }

  /* Shared by the splash prompt and the hero's closing prompt */
  .cursor {
    display: inline-block;
    width: 0.6ch;
    height: 1.1em;
    margin-left: 2px;
    vertical-align: text-bottom;
    background: var(--accent);
  }
  .cursor.blink { animation: blink 1.05s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  .no-splash .splash { display: none; }
</style>

<script>
  import '../setup/lenis';
</script>