---
import "@fontsource-variable/jetbrains-mono";
import "@fontsource-variable/instrument-sans";
import "../styles/theme.css";
import Topbar from "../components/topbar.astro";

interface Props {
  title?: string;
  description?: string;
}

const { title = "Om Patel", description = "Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Splash plays on every load/refresh. Skipped for reduced-motion users,
         and once when arriving via the top bar's home link. -->
    <script is:inline>
      (function () {
        var skip = matchMedia("(prefers-reduced-motion: reduce)").matches;
        try {
          if (sessionStorage.getItem("skip-splash")) {
            skip = true;
            sessionStorage.removeItem("skip-splash");
          }
        } catch (e) {}
        if (skip) document.documentElement.classList.add("no-splash");
      })();
    </script>

    <noscript>
      <style is:inline>
        .splash {
          display: none !important;
        }
        .hero .inner {
          transform: none !important;
        }
        .hero [data-fade] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>

  <body>
    <Topbar />
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --topbar-h: 2.5rem;
    /* colors live in src/styles/theme.css */

    --mono: "JetBrains Mono Variable", ui-monospace, monospace;
    --sans: "Instrument Sans Variable", system-ui, sans-serif;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
    color: var(--fg);
    scroll-padding-top: var(--topbar-h);
  }

  body {
    margin: 0;
    padding-top: var(--topbar-h);
    font-family: var(--sans);
    -webkit-font-smoothing: antialiased;
  }

  /* Scrollbars: the page's is hidden (it still scrolls), inner ones (terminal, windows) are slim */
  * {
    scrollbar-width: thin;
    scrollbar-color: var(--line-strong) transparent;
  }
  html {
    scrollbar-width: none;
  }
  html::-webkit-scrollbar {
    display: none;
  }
  @supports not (scrollbar-width: thin) {
    *::-webkit-scrollbar {
      width: 5px;
      height: 5px;
    }
    *::-webkit-scrollbar-thumb {
      background: var(--line-strong);
      border-radius: 3px;
    }
    *::-webkit-scrollbar-track,
    *::-webkit-scrollbar-corner {
      background: transparent;
    }
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  /* Shared by the splash prompt and the hero's closing prompt */
  .cursor {
    display: inline-block;
    width: 0.6ch;
    height: 1.1em;
    margin-left: 2px;
    vertical-align: text-bottom;
    background: var(--accent);
  }
  .cursor.blink {
    animation: blink 1.05s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* html.* + !important so it beats the splash's own scoped display:flex */
  html.no-splash .splash {
    display: none !important;
  }
</style>

<script>
  import "../setup/lenis";
</script>
